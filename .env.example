# Node 24.15+; npm ci && npm run dev
PORT=3001
DATA_DIR=./data
# Production web origin (comma separated if multiple). Required for public deployment.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set only on the server. Never expose in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
MAX_DAILY_GENERATED_IMAGES=48
# HTTPS production should use secure cookies.
# NODE_ENV=production
# COOKIE_SECURE=true
# Durable total limit across all accounts, including deleted projects.
MAX_GLOBAL_DAILY_GENERATED_IMAGES=96
# Optional private-launch allowlist; empty means any registered account (subject to quotas).
GENERATION_ALLOWED_EMAILS=
# Use only behind exactly one trusted reverse proxy.
# TRUST_PROXY=1
